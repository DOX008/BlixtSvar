<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overlayScrim"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/stack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Rubrik-kort -->
        <LinearLayout
            android:id="@+id/headerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_dark"
            android:padding="20dp"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/title_logo"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:src="@drawable/bs"
                android:contentDescription="@string/app_name"
                android:adjustViewBounds="true"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="1dp" />
        </LinearLayout>

        <!-- Status-kort (för långa svar) -->
        <LinearLayout
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_mid"
            android:padding="16dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/statusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Svar skickad:"
                android:textColor="@color/overlayTitle"
                android:textSize="16sp"
                android:layout_marginBottom="6dp" />

            <!-- Själva svaret: centreras, kan bli flera rader, autosize vid behov -->
            <TextView
                android:id="@+id/statusValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/overlayText"
                android:textSize="28sp"
                android:textStyle="bold"
                android:maxLines="4"
                android:ellipsize="end"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="16sp"
                app:autoSizeMaxTextSize="28sp"
                app:autoSizeStepGranularity="2sp" />
        </LinearLayout>

        <!-- Meddelande-kort -->
        <LinearLayout
            android:id="@+id/messageCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_dark"
            android:padding="20dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="16dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:id="@+id/messageBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/overlayText"
                        android:textSize="18sp"
                        android:lineSpacingExtra="4dp"
                        android:gravity="center_horizontal"
                        android:textAlignment="center" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- OK-knapp med rundade hörn -->
        <Button
            android:id="@+id/okButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="OK"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:background="@drawable/bg_button_rounded"
            android:padding="10dp" />
    </LinearLayout>
</FrameLayout>
