<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <!-- Mörk bakgrund för pillen (som i din bild 1) -->
    <solid android:color="#24313C"/>
    <!-- Lätt rundning – öka till 24dp om du vill ännu rundare -->
    <corners android:radius="18dp"/>
    <!-- (valfritt) tunn, lite ljusare kant -->
    <stroke android:width="1dp" android:color="#324457"/>
    <!-- Inre padding så texten inte sitter mot kanten -->
    <padding android:left="12dp" android:top="8dp" android:right="12dp" android:bottom="8dp"/>
</shape>
